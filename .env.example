# Ban sao mau cua file .env — doi ten thanh .env roi chinh cho may cua ban.
# File .env that KHONG duoc commit (no mat khau + khoa cookie dang nhap).

# --- Camera preview (chi danh cho DEVELOPER debug) ---
# Che do NUT NHAN (khuyen dung chay that): DE TRONG STREAM_URL.
#   Neu de URL esp32:81/stream, server se PULL lien tuc -> cam ESP32 khong bao
#   gio tat + trang debug luc nao cung co hinh. Chi dien URL khi muon dev xem
#   preview lien tuc (PULL) hoac dung dien thoai lam camera IP.
STREAM_URL =
HOST = 0.0.0.0

# --- Hai cong cung mot tien trinh ---
# PORT        = cong QUAN LY: 1 trang dang nhap duy nhat, tu dieu huong theo
#               vai tro (admin / giao vien -> trang quan ly; developer -> debug).
#               Admin va giao vien chi dung cong nay.
# CAMERA_PORT = cong DEBUG rieng cua DEVELOPER: preview camera, cai dat
#               ESP32-CAM, cau hinh engine nhan dien. Khac voi PORT (neu trung
#               thi server tu day cong camera len +1).
PORT = 5000
CAMERA_PORT = 5001
PROCESS_FPS = 12
JPEG_QUALITY = 72

# --- Nhan dien ---
# MATCH_THRESHOLD = "khoang cach toi nhat" da duoc chap nhan (cang nho cang giong).
#   SFace (mac dinh): thang 0..2, danh giac tot nhat la 0.42
#   LBPH (neu thieu model SFace): thang 0..150,gia tri mac dinh 75
MATCH_THRESHOLD = 0.42
# MATCH_MARGIN = do lech toi thieu so voi ung vien thu hai (chong doan sai).
MATCH_MARGIN = 0.1
# DETECT_SCORE = nguong chac chan cua detector YuNet (0..1)
DETECT_SCORE = 0.62
# MIN_FACE_SIZE = bo qua mat nho hon (px)
#   Dien thoai: 44. ESP32-CAM VGA/QVGA xa 2-3m: ha xuong 24-32 neu mat bi bo qua.
MIN_FACE_SIZE = 44
# --- Cong chat luong khi CHOT TEN (chong nhan nham nguoi la) ---
# RECOGNIZE_MIN_FACE = canh mat toi thieu (px, quy ve khung rong 640) moi duoc
#   chot ten. Mat nho hon -> vector SFace nhieu -> de khop nham. Tang len neu
#   con nhan nham; giam xuong neu hoc sinh dung xa bi bo qua.
RECOGNIZE_MIN_FACE = 64
# RECOGNIZE_BLUR_MIN = do net Laplacian toi thieu cua vung mat moi duoc chot ten.
RECOGNIZE_BLUR_MIN = 15

# --- Theo doi mat (o vuong) ---
# TRACK_ENABLED = giu ID nguoi + lam mat o vuong qua cac khung mat/chong nang
TRACK_ENABLED = 1
# TRACK_CONFIRM = so khung lien tiep khop moi hien ten (chong nhap nhay nhan)
TRACK_CONFIRM = 3
# TRACK_MAX_AGE = so khung lien tiep khong detect van giu o vuong
TRACK_MAX_AGE = 12
# TRACK_SMOOTH = 0..1, cang lon o vuong cang "chay" theo mat
TRACK_SMOOTH = 0.45
# TRACK_BACKEND = medianflow | csrt | kcf | none
TRACK_BACKEND = medianflow

LOG_INTERVAL = 8

# --- Bao mat ---
# ADMIN_PASSWORD = mat khau tai khoan "admin" (dang nhap ten "admin").
#   MAC DINH "admin" — HAY DOI truoc khi dua may nay len mang truong.
ADMIN_PASSWORD = doi_mat_khau_nay
# DEV_USERNAME / DEV_PASSWORD = tai khoan DEVELOPER mo cong debug (CAMERA_PORT).
#   Ten dang nhap mac dinh "developer"; mat khau mac dinh "developer".
DEV_USERNAME = developer
DEV_PASSWORD = doi_mat_khau_nay
# Giao vien do admin tao tai tab "Giao vien" cua trang quan ly (khong can day).
# SECRET_KEY = khoa ky cookie dang nhap. DE TRONG: server tu sinh va ghi vao .env
#   lan dau chay. Giu nguyen de khong phai dang nhap lai moi lan khoi dong lai may chu.
SECRET_KEY =