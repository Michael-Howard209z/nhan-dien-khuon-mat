data/

# --- Ảnh nhật ký từ các script kiểm tra ---
out_*.jpg

# --- Log ---
*.log

# --- Nhị phân công cụ lạ vô tình nằm trong thư mục dự án ---
opencode.exe
# --- Trang thai phat trien / ban sao cu (khong commit) ---
.opencode/
backup-*/
